<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<TabPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="800.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="be.lifeisbananas.MainController">
  <tabs>
    <Tab text="Product Beheren">
      <content>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
               <children>
                  <AnchorPane layoutY="14.0" prefHeight="406.0" prefWidth="800.0">
                     <children>
                        <Label layoutX="50.0" layoutY="30.0" text="Product Naam:" />
                        <TextField fx:id="textProductNaam" layoutX="180.0" layoutY="26.0" prefWidth="200.0" />

                        <Label layoutX="50.0" layoutY="65.0" text="Beschrijving:" />
                        <TextField fx:id="textBeschrijving" layoutX="180.0" layoutY="61.0" prefWidth="200.0" />

                        <Label layoutX="50.0" layoutY="100.0" text="Houdbaarheid (dagen):" />
                        <TextField fx:id="textHoudbaarheid" layoutX="180.0" layoutY="96.0" prefWidth="100.0" />

                        <Label layoutX="50.0" layoutY="135.0" text="Gewicht (gram):" />
                        <TextField fx:id="textGewicht" layoutX="180.0" layoutY="131.0" prefWidth="100.0" />

                        <Label layoutX="50.0" layoutY="170.0" text="Batch Nummer:" />
                        <TextField fx:id="textBatchNummer" layoutX="180.0" layoutY="166.0" prefWidth="200.0" />

                        <Button fx:id="buttonMaakProduct" layoutX="50.0" layoutY="210.0" mnemonicParsing="false" onAction="#actionMaakProduct" prefHeight="30.0" prefWidth="330.0" text="Maak Nieuw Product (IN_DEVELOPMENT)" />

                        <TextArea fx:id="textAreaProductLijst" layoutX="420.0" layoutY="26.0" prefHeight="210.0" prefWidth="350.0" />

                        <TextArea fx:id="textAreaMelding" layoutX="50.0" layoutY="260.0" prefHeight="120.0" prefWidth="720.0" />
                     </children>
                  </AnchorPane>
               </children></AnchorPane>
      </content>
    </Tab>
    <Tab text="Status Wijzigen">
      <content>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
               <children>
                  <AnchorPane layoutY="7.0" prefHeight="413.0" prefWidth="800.0">
                     <children>
                        <Label layoutX="100.0" layoutY="50.0" text="Product Naam:" />
                        <TextField fx:id="textProductNaamStatus" layoutX="220.0" layoutY="46.0" prefHeight="24.0" prefWidth="400.0" />

                        <Label layoutX="100.0" layoutY="100.0" text="Huidige Status:" />
                        <TextField fx:id="textHuidigeStatus" layoutX="220.0" layoutY="96.0" prefHeight="24.0" prefWidth="400.0" editable="false" />

                        <Button layoutX="220.0" layoutY="140.0" mnemonicParsing="false" onAction="#actionMarkeerAlsGetest" prefHeight="30.0" prefWidth="400.0" text="Markeer als TESTED" />

                        <Button layoutX="220.0" layoutY="180.0" mnemonicParsing="false" onAction="#actionGoedkeurenProduct" prefHeight="30.0" prefWidth="400.0" text="Goedkeuren (APPROVED)" />

                        <Button layoutX="220.0" layoutY="220.0" mnemonicParsing="false" onAction="#actionStartProductie" prefHeight="30.0" prefWidth="400.0" text="Start Productie (IN_PRODUCTION)" />

                        <TextArea fx:id="textAreaStatusMelding" layoutX="100.0" layoutY="270.0" prefHeight="120.0" prefWidth="600.0" />
                     </children></AnchorPane>
               </children></AnchorPane>
      </content>
    </Tab>
  </tabs>
</TabPane>
